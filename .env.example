# ============================================
# env template. Copy in .env and fill in:
#   cp .env.example .env
#
# Values for PostgreSQL get in Neon Console:
#   Project → Connection Details
# ============================================

# local | dev | prod
ENV=local
IS_DEBUG=true
# debug | info | warn | error
LOG_LEVEL=debug

# --- HTTP ---
# 127.0.0.1 локально, 0.0.0.0 в контейнере
BIND_IP=127.0.0.1
PORT=10000

# --- PostgreSQL ---
# Хост без суффикса -pooler: свой пул в database/sql,
# PgBouncer поверх конфликтует с prepared statements в lib/pq
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# require для Neon, disable для локального Postgres
POSTGRES_SSLMODE=require

# Для goose и psql. Формат:
# postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
DATABASE_URL=